[Unit]
Description=Food Django web (gunicorn)
After=network.target

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/food
EnvironmentFile=/home/ubuntu/food/.env
Environment=DJANGO_DEBUG=False
Environment=TZ=Asia/Seoul
ExecStart=/home/ubuntu/food/.venv/bin/gunicorn restaurants.wsgi:application -b 0.0.0.0:8000
Restart=always
MemoryMax=512M

[Install]
WantedBy=multi-user.target
